{
  "manifest_version": 3,
  "name": "1688 智能助手",
  "version": "0.5.2",
  "description": "1688 买家侧辅助工具：监控商品 SKU 变化并通知；揽收超时自动理赔（框架）。个人自用，依赖当前浏览器已登录的 1688 账号。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "1688 智能助手",
    "default_popup": "pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://*.1688.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}